# WorkBuddy 工作区数据（本地缓存、记忆日志，不入库）
.workbuddy/

# 版本库自身（git 语义上本就忽略，这里显式写出，
# 防止任何按 .gitignore 扫描目录的脚本把 .git 一并打包上传）
.git/

# 系统文件
.DS_Store
Thumbs.db

# 依赖与临时文件
node_modules/
*.tmp
*.bak
*.log

# 本地内部文档目录：整目录只留在本机，不随仓库发布
# （对外可见的文档放 pages/，例如关于页与隐私政策）
docs/

# WorkBuddy 本地应用描述文件（含本机绝对路径，不入库）
*.genie
